# Comma-separated list of proxy URLs (optional)
# Format: http://user:pass@host:port  (credentials are passed to the browser separately)
PROXY_LIST=

# Comma-separated list of target URLs to scrape (or pass URLs / --urls-file on the command line)
TARGET_URLS=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html

# Number of attempts per URL (each retry uses a different proxy when available)
MAX_RETRIES=3

# Base delay between retries in seconds (exponential backoff: 2, 4, 8…)
RETRY_DELAY=2.0

# Pages scraped in parallel
CONCURRENCY=2

# Page navigation timeout in seconds
NAV_TIMEOUT=30

# A proxy is benched for PROXY_COOLDOWN seconds after PROXY_MAX_FAILURES consecutive failures
PROXY_MAX_FAILURES=3
PROXY_COOLDOWN=300

# Optional site-specific selectors (see selectors.example.json)
SELECTORS_FILE=selectors.json

# Directory where CSV/JSON output files are saved
OUTPUT_DIR=output
